{
    "manifest_version": 3,
    "name": "AI Block - beta version",
    "version": "1.1.5",
    "description": "Google AI Overview blocker",
    "browser_specific_settings": {
        "gecko": {
            "id": "ai-block-beta@twonest.com",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "icons": {
        "16": "icon-16.png",
        "32": "icon-32.png",
        "48": "icon-48.png",
        "128": "icon-128.png"
    },
    "permissions": [
        "storage",
        "webRequest",
        "webRequestBlocking"
    ],
    "host_permissions": [
        "*://*.google.com/search*",
        "*://*.google.fr/search*"
    ],
    "background": {
        "scripts": ["background.js"]
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.google.com/search*",
                "*://*.google.fr/search*"
            ],
            "css": ["style.css"],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_popup": "popup.html"
    }
}